# Multi-Model Configuration Example
# Copy this file to .env and fill in your API keys

# ===========================================
# MODEL SELECTION
# ===========================================
# Set which model to use - change this to switch models
# Options: anthropic, llama4 (or any model name from config/ directory)
# IMPORTANT: Restart the application after changing this value
CURRENT_MODEL=anthropic

# ===========================================
# ANTHROPIC (Claude Models)
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ===========================================
# OPENAI / OPENAI-COMPATIBLE APIS
# ===========================================
# For Llama4 and other OpenAI-compatible endpoints
# Note: Some endpoints don't require a real API key
OPENAI_API_KEY=dummy-key

# ===========================================
# CHAINLIT CONFIGURATION
# ===========================================
# Optional: Customize Chainlit settings
CHAINLIT_AUTH_SECRET=your_secret_here

# ===========================================
# DEBUGGING
# ===========================================
# Set to True to enable debug logging
DEBUG=False
